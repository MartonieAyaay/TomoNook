# Copy to .env (never commit .env) and fill in.

# PostgreSQL connection string, e.g. from Neon (Vercel → Storage → Neon).
# On Vercel, set it under Project → Settings → Environment Variables.
# Leave it unset locally to use the built-in dev database in server/data/pglite.
DATABASE_URL=

# Optional: extra sites allowed to call the login API, comma-separated
# (e.g. a custom domain). The site's own address is always allowed.
ALLOWED_ORIGINS=

# Email for "Forgot password?" (any SMTP service). Without these, local
# development prints the email to the server console instead.
# Gmail: turn on 2-Step Verification, then make an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who the email says it's from. Defaults to "TomoNook <SMTP_USER>".
MAIL_FROM=

# Optional: the site's address used in emailed links. On Vercel it defaults
# to the production address (e.g. https://tomonook.vercel.app).
APP_URL=
